<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the desktop UI, rendered headless with Avalonia + Skia (real pixels, no screen): every page light and dark, the keyboard flows
    of the forms, toolbars and pagination, the snapshot, the tray menu, the copies of MatDesktop and of the MatCloud contract, and that no
    window writes a colour of its own (THIXSYNC_SCREENSHOTS=<folder> keeps screenshots).
  -->
  <PropertyGroup>
    <TargetFramework>$(DesktopTargetFramework)</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="GitHubActionsTestLogger" Version="2.4.1" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ThixSync\ThixSync.csproj" />
    <ProjectReference Include="..\..\src\ThixSync.Core\ThixSync.Core.csproj" />
  </ItemGroup>

</Project>
