<Project>
  <!--
    The app registrations of ThixSync for LOCAL builds (docs/APP-REGISTRIERUNG.md). Copy this file to secrets.local.props
    (ignored by git) and fill in the values; Directory.Build.props imports it. CI uses the repository secrets
    THIXSYNC_GOOGLE_CLIENT_ID, THIXSYNC_GOOGLE_CLIENT_SECRET, THIXSYNC_MICROSOFT_CLIENT_ID, THIXSYNC_DROPBOX_CLIENT_ID,
    THIXSYNC_BOX_CLIENT_ID and THIXSYNC_BOX_CLIENT_SECRET instead. Empty values: that cloud cannot sign in with the built-in
    registration (a user can still enter an own one in Einstellungen › Erweitert).
  -->
  <PropertyGroup>
    <ThixSyncGoogleClientId></ThixSyncGoogleClientId>
    <ThixSyncGoogleClientSecret></ThixSyncGoogleClientSecret>
    <ThixSyncMicrosoftClientId></ThixSyncMicrosoftClientId>
    <ThixSyncDropboxClientId></ThixSyncDropboxClientId>
    <ThixSyncBoxClientId></ThixSyncBoxClientId>
    <ThixSyncBoxClientSecret></ThixSyncBoxClientSecret>
  </PropertyGroup>
</Project>
