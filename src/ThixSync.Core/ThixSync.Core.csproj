<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Models, business layer (static classes), infrastructure and the native parts of the desktop app (scanner, SMB shares,
    trash) for Windows and macOS. No UI. Windows-only code is guarded by OperatingSystem.IsWindows() or
    [SupportedOSPlatform("windows")].
    MatCloud/ is a COPY of the contract of MatCloud (routes, DTOs, MatCloudClient): never edited here, copied again with
    node ../MatCloud/tools/contract-copy.js src/ThixSync.Core (see CLAUDE.md).
  -->
  <PropertyGroup>
    <TargetFramework>$(DesktopTargetFramework)</TargetFramework>
    <RootNamespace>ThixSync.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixSync.Tests" />
    <InternalsVisibleTo Include="ThixSync" />
    <InternalsVisibleTo Include="ThixSync.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the setup offers (SETUP-08): read by InstallerOptions, published in the update manifest by CI -->
    <EmbeddedResource Include="installer.json" LogicalName="installer.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MEGA (Storage/Providers/Mega): MegaApiClient (gpailler, MIT) does MEGA's client-side encryption, sign-in and transfers.
      It asks for Newtonsoft.Json 10, which has a known vulnerability (GHSA-5crp-9r3c-p9vr): 13.x (MIT) is referenced instead.
      S3, Azure and pCloud are plain REST code of their own (no SDK).
    -->
    <PackageReference Include="MegaApiClient" Version="1.10.5" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Network & server providers (Storage/Providers/Sftp, Ftp): SSH.NET (MIT) for SFTP / rsync over SSH / Hetzner Storage Box,
         FluentFTP (MIT) for FTP / FTPS. WebDAV, Nextcloud and Seafile use HttpClient only. -->
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
  </ItemGroup>

</Project>
