<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mat="using:MatDesktop"
             xmlns:controls="using:ThixSync.Controls"
             x:Class="ThixSync.Pages.SettingsPage">
  <!-- Settings in tabs: Allgemein | Übertragung | Remote | Cloud | Updates | Erweitert. A switch applies at once (like macOS). -->
  <Border Background="{DynamicResource Mat.Surface}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="36,28,36,28" MaxWidth="880" HorizontalAlignment="Left">
        <TextBlock Text="Einstellungen" Theme="{StaticResource MatText.PageTitle}" />
        <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,4,0,0"
                   Text="Die Einstellungen dieses Computers. Aufträge und Verbindungen gleicht die Cloud ab, diese Einstellungen nicht." />
        <controls:InfoBar x:Name="PolicyNote" Margin="0,14,0,0" />
        <controls:InfoBar x:Name="PageMessage" Margin="0,14,0,0" />

        <TabControl x:Name="Tabs" Margin="0,14,0,0">
          <!-- ===== General ===== -->
          <TabItem x:Name="GeneralTabItem" Header="Allgemein">
            <StackPanel>
              <mat:MatSettingRow Title="Erscheinungsbild">
                <ComboBox x:Name="ThemeChoice" MinWidth="220" AutomationProperties.Name="Erscheinungsbild">
                  <ComboBoxItem Content="Wie das System" />
                  <ComboBoxItem Content="Hell" />
                  <ComboBoxItem Content="Dunkel" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Mitteilungen" Description="Wann ThixSync nach einem Lauf Bescheid gibt, den du nicht selbst gestartet hast.">
                <ComboBox x:Name="NotifyChoice" MinWidth="220" AutomationProperties.Name="Mitteilungen">
                  <ComboBoxItem Content="Nie" />
                  <ComboBoxItem Content="Nur bei Problemen" />
                  <ComboBoxItem Content="Bei Änderungen und Problemen" />
                </ComboBox>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Bei der Anmeldung starten" Description="ThixSync startet unsichtbar im Infobereich / in der Menüleiste und führt dort die geplanten Synchronisationen aus.">
                <ToggleSwitch x:Name="AutostartSwitch" OnContent="" OffContent="" AutomationProperties.Name="Bei der Anmeldung starten" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Protokolle aufbewahren" BorderThickness="0" Description="Wie lange die Läufe mit ihren Zeilen auf diesem Computer bleiben.">
                <ComboBox x:Name="KeepProtocolChoice" MinWidth="220" AutomationProperties.Name="Protokolle aufbewahren" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="KeepProtocolDays" Margin="0" />
            </StackPanel>
          </TabItem>

          <!-- ===== Transfers ===== -->
          <TabItem x:Name="TransferTabItem" Header="Übertragung">
            <StackPanel>
              <mat:MatSettingRow Title="Gleichzeitige Übertragungen" Description="Dateien, die ein Auftrag auf „automatisch“ zugleich kopiert. 0: ThixSync wählt je nach Quelle und Ziel.">
                <NumericUpDown x:Name="ParallelismBox" Minimum="0" Maximum="128" Increment="1" FormatString="0" Width="160" AutomationProperties.Name="Gleichzeitige Übertragungen" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="DefaultParallelism" Margin="0" />
              <mat:MatSettingRow Title="Gleichzeitige Aufträge" Description="So viele Synchronisationen laufen zugleich; weitere warten in der Reihe.">
                <NumericUpDown x:Name="ConcurrentJobsBox" Minimum="1" Maximum="16" Increment="1" FormatString="0" Width="160" AutomationProperties.Name="Gleichzeitige Aufträge" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="MaxConcurrentJobs" Margin="0" />
              <mat:MatSettingRow Title="Bandbreite begrenzen" Description="Höchstens so viele KB/s für alle Aufträge zusammen. 0: unbegrenzt.">
                <NumericUpDown x:Name="BandwidthBox" Minimum="0" Maximum="10000000" Increment="512" FormatString="0" Width="160" AutomationProperties.Name="Bandbreite in KB/s" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="BandwidthLimitKiB" Margin="0" />
              <mat:MatSettingRow Title="Wiederholungen" Description="So oft versucht ein Lauf eine Datei noch einmal, die nicht ging (gesperrt, Netz weg).">
                <NumericUpDown x:Name="RetriesBox" Minimum="0" Maximum="10" Increment="1" FormatString="0" Width="160" AutomationProperties.Name="Wiederholungen" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="Retries" Margin="0" />
              <mat:MatSettingRow Title="Kleine Dateien bis" Description="Dateien bis zu dieser Größe (KB) gehen gebündelt über die schnelle Spur – das hilft bei vielen kleinen Dateien.">
                <NumericUpDown x:Name="SmallFilesBox" Minimum="0" Maximum="1048576" Increment="256" FormatString="0" Width="160" AutomationProperties.Name="Kleine Dateien bis KB" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="SmallFileThresholdKiB" Margin="0" />
              <mat:MatSettingRow Title="Im Akkubetrieb pausieren" BorderThickness="0" Description="Läuft der Computer mit Akku, starten keine Aufträge nach Zeitplan. Von Hand geht es weiter.">
                <ToggleSwitch x:Name="BatterySwitch" OnContent="" OffContent="" AutomationProperties.Name="Im Akkubetrieb pausieren" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Remote ===== -->
          <TabItem x:Name="RemoteTabItem" Header="Remote">
            <StackPanel>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,12"
                         Text="Mit ThixSync Remote gleicht ein anderer Computer direkt mit Ordnern dieses Computers ab – verschlüsselt, ohne Cloud dazwischen. Er braucht einmal einen Kopplungscode von hier." />
              <controls:InfoBar x:Name="RemoteMessage" />
              <mat:MatSettingRow Title="Andere Computer dürfen sich verbinden" Description="Nur gekoppelte Computer, nur die Freigaben unten.">
                <ToggleSwitch x:Name="RemoteSwitch" OnContent="" OffContent="" AutomationProperties.Name="Andere Computer dürfen sich verbinden" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Port" Description="TCP-Port, auf dem dieser Computer wartet (Standard 47600).">
                <NumericUpDown x:Name="PortBox" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Width="160" AutomationProperties.Name="Port" />
              </mat:MatSettingRow>
              <mat:MatFormField controls:FormErrors.Field="Port" Margin="0" />
              <mat:MatSettingRow x:Name="FingerprintRow" Title="Fingerabdruck dieses Computers" BorderThickness="0"
                                 Description="Der andere Computer zeigt ihn beim Koppeln – vergleiche ihn.">
                <SelectableTextBlock x:Name="FingerprintText" FontFamily="{DynamicResource Mat.Mono}" FontSize="{DynamicResource Mat.FontSizeSm}" MaxWidth="360" TextWrapping="Wrap" />
              </mat:MatSettingRow>

              <TextBlock Text="Freigaben" Theme="{StaticResource MatText.SectionTitle}" FontSize="{DynamicResource Mat.FontSizeLg}" Margin="0,20,0,10" />
              <StackPanel x:Name="SharesList" Spacing="8" />
              <Grid ColumnDefinitions="200,*,Auto,Auto" Margin="0,10,0,0">
                <mat:MatFormField controls:FormErrors.Field="Name" Label="Name der Freigabe" Margin="0,0,10,0">
                  <TextBox x:Name="ShareNameBox" Watermark="z. B. Dokumente" />
                </mat:MatFormField>
                <mat:MatFormField Grid.Column="1" controls:FormErrors.Field="LocalPath" Label="Ordner" Margin="0,0,10,0">
                  <TextBox x:Name="SharePathBox" />
                </mat:MatFormField>
                <Button Grid.Column="2" VerticalAlignment="Top" Margin="0,25,10,0" Click="OnPickShareFolderClick">
                  <controls:IconLabel Icon="folder-open" Text="Durchsuchen …" />
                </Button>
                <Button Grid.Column="3" x:Name="AddShareButton" VerticalAlignment="Top" Margin="0,25,0,0" Click="OnAddShareClick">
                  <controls:IconLabel Icon="plus" Text="Hinzufügen" />
                </Button>
              </Grid>

              <TextBlock Text="Koppeln" Theme="{StaticResource MatText.SectionTitle}" FontSize="{DynamicResource Mat.FontSizeLg}" Margin="0,18,0,10" />
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,12"
                         Text="Auf dem anderen Computer: Geräte › Neue Verbindung › ThixSync Remote, dann den Code von hier eingeben." />
              <controls:ActionBar>
                <Button x:Name="PairingButton" Theme="{StaticResource MatButton.Primary}" Click="OnPairingClick">
                  <controls:IconLabel Icon="link" Text="Kopplungscode anzeigen" />
                </Button>
              </controls:ActionBar>
              <Border x:Name="PairingCard" Theme="{StaticResource MatCard}" IsVisible="False" Margin="0,14,0,0" MaxWidth="520" HorizontalAlignment="Left" Padding="22,18">
                <StackPanel Spacing="8">
                  <TextBlock Text="Kopplungscode" Theme="{StaticResource MatText.Muted}" />
                  <SelectableTextBlock x:Name="PairingCodeText" FontFamily="{DynamicResource Mat.Mono}" FontSize="40" FontWeight="SemiBold" LetterSpacing="6"
                                       Foreground="{DynamicResource Mat.AccentText}" AutomationProperties.Name="Kopplungscode" />
                  <TextBlock x:Name="PairingExpiryText" Theme="{StaticResource MatText.Muted}" />
                </StackPanel>
              </Border>

              <TextBlock Text="Gekoppelte Computer" Theme="{StaticResource MatText.SectionTitle}" FontSize="{DynamicResource Mat.FontSizeLg}" Margin="0,22,0,10" />
              <StackPanel x:Name="PeersList" Spacing="8" />
            </StackPanel>
          </TabItem>

          <!-- ===== Cloud ===== -->
          <TabItem x:Name="CloudTabItem" Header="Cloud">
            <StackPanel>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,16"
                         Text="Mit der MatCloud sind deine Synchronisationsprofile (Aufträge und Verbindungen ohne Passwörter) auf allen Geräten gleich. Passwörter, Protokolle und Einstellungen bleiben auf jedem Computer." />
              <controls:InfoBar x:Name="CloudMessage" />

              <!-- Not connected: sign in, in the browser (every account, also MatIdentity) or with user name and password -->
              <StackPanel x:Name="CloudLogin" MaxWidth="520" HorizontalAlignment="Left">
                <mat:MatFormField Label="Adresse der Cloud" controls:FormErrors.Field="ServerUrl" Hint="Die Adresse deiner MatCloud, z. B. https://cloud.example.com">
                  <TextBox x:Name="ServerUrlBox" Watermark="https://" />
                </mat:MatFormField>
                <mat:MatFormField Label="Name dieses Geräts" controls:FormErrors.Field="DeviceName" Hint="So erscheint dieser Computer in der MatCloud unter „Geräte“.">
                  <TextBox x:Name="DeviceNameBox" />
                </mat:MatFormField>

                <!-- The first way: in the browser -->
                <StackPanel x:Name="BrowserSignIn" Margin="0,6,0,0">
                  <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,12"
                             Text="Die Anmeldung öffnet sich im Browser: Melde dich dort an – mit deinem Konto der MatCloud oder über MatIdentity – und bestätige den Code, den ThixSync dir zeigt." />
                  <controls:ActionBar>
                    <Button x:Name="BrowserConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnBrowserConnectClick">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                    <Button x:Name="ShowPasswordSignInButton" Click="OnShowPasswordSignInClick">
                      <controls:IconLabel Icon="key" Text="Mit Benutzername und Passwort" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>

                <!-- Waiting for the browser: the code to compare -->
                <Border x:Name="BrowserCode" Theme="{StaticResource MatCard}" IsVisible="False" Margin="0,6,0,0">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Dein Code" Theme="{StaticResource MatText.Muted}" />
                    <SelectableTextBlock x:Name="BrowserCodeText" FontFamily="{DynamicResource Mat.Mono}" FontSize="{DynamicResource Mat.FontSize3xl}"
                                         FontWeight="SemiBold" LetterSpacing="3" Foreground="{DynamicResource Mat.AccentText}" AutomationProperties.Name="Code" />
                    <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="Bestätige den Code im Browser." />
                    <TextBlock x:Name="BrowserCodeHint" Theme="{StaticResource MatText.Muted}"
                               Text="Melde dich auf der Seite der MatCloud an und prüfe, dass dort derselbe Code steht. ThixSync verbindet sich, sobald du bestätigt hast." />
                    <controls:ActionBar Margin="0,4,0,0">
                      <Button x:Name="OpenLinkButton" Click="OnOpenLinkClick">
                        <controls:IconLabel Icon="external" Text="Seite erneut öffnen" />
                      </Button>
                      <Button x:Name="CancelLinkButton" Click="OnCancelLinkClick">
                        <controls:IconLabel Icon="x" Text="Abbrechen" />
                      </Button>
                    </controls:ActionBar>
                  </StackPanel>
                </Border>

                <!-- The second way: user name and password of a local account -->
                <StackPanel x:Name="PasswordSignIn" IsVisible="False" Margin="0,6,0,0">
                  <mat:MatFormField Label="Benutzername" controls:FormErrors.Field="UserName">
                    <TextBox x:Name="UserNameBox" />
                  </mat:MatFormField>
                  <mat:MatFormField Label="Passwort" controls:FormErrors.Field="Password" Hint="Wird nur für die Anmeldung gebraucht und nicht gespeichert.">
                    <TextBox x:Name="PasswordBox" PasswordChar="●" />
                  </mat:MatFormField>
                  <controls:ActionBar Margin="0,6,0,0">
                    <Button x:Name="ConnectButton" Theme="{StaticResource MatButton.Primary}" Click="OnConnectClick">
                      <controls:IconLabel Icon="login" Text="Anmelden" />
                    </Button>
                    <Button x:Name="ShowBrowserSignInButton" Click="OnShowBrowserSignInClick">
                      <controls:IconLabel Icon="globe" Text="Im Browser anmelden" />
                    </Button>
                  </controls:ActionBar>
                </StackPanel>
              </StackPanel>

              <!-- Connected: state and actions -->
              <StackPanel x:Name="CloudConnected" IsVisible="False" Spacing="16">
                <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Text="Cloud" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <SelectableTextBlock Grid.Column="1" x:Name="CloudServerText" Margin="0,4" />
                    <TextBlock Grid.Row="1" Text="Konto" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CloudAccountText" Margin="0,4" />
                    <TextBlock Grid.Row="2" Text="Dieses Gerät" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CloudDeviceText" Margin="0,4" />
                    <TextBlock Grid.Row="3" Text="Status" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CloudStateText" Margin="0,4" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="4" Text="Zuletzt" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CloudLastSyncText" Margin="0,4" />
                  </Grid>
                </Border>
                <controls:ActionBar>
                  <Button Theme="{StaticResource MatButton.Primary}" Click="OnSyncNowClick">
                    <controls:IconLabel Icon="refresh" Text="Jetzt abgleichen" />
                  </Button>
                  <Button Click="OnOpenCloudClick">
                    <controls:IconLabel Icon="external" Text="Im Browser öffnen" />
                  </Button>
                  <Button x:Name="DisconnectButton" Theme="{StaticResource MatButton.Danger}" controls:ActionBar.Separated="True" Click="OnDisconnectClick">
                    <controls:IconLabel Icon="logout" Text="Abmelden" />
                  </Button>
                </controls:ActionBar>
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- ===== Updates ===== -->
          <TabItem x:Name="UpdatesTabItem" Header="Updates">
            <StackPanel>
              <Border Theme="{StaticResource MatCard}" MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,0,14">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="Installiert" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Column="1" x:Name="InstalledVersionText" Margin="0,4" />
                  <TextBlock Grid.Row="1" Text="Kanal" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ChannelText" Margin="0,4" />
                  <TextBlock Grid.Row="2" Text="Zuletzt geprüft" Theme="{StaticResource MatText.Muted}" Margin="0,4,24,4" />
                  <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LastCheckText" Margin="0,4" />
                </Grid>
              </Border>
              <controls:InfoBar x:Name="UpdateMessage" />
              <ProgressBar x:Name="UpdateProgress" Theme="{StaticResource MatProgress}" IsVisible="False" Maximum="1" Margin="0,0,0,12" MaxWidth="560" HorizontalAlignment="Stretch" />
              <controls:ActionBar Margin="0,0,0,10">
                <Button x:Name="CheckUpdateButton" Click="OnCheckUpdateClick">
                  <controls:IconLabel Icon="refresh" Text="Nach Updates suchen" />
                </Button>
                <Button x:Name="InstallUpdateButton" Theme="{StaticResource MatButton.Primary}" Click="OnInstallUpdateClick" IsVisible="False">
                  <controls:IconLabel Icon="download" Text="Update installieren" />
                </Button>
                <Button Click="OnReleasePageClick">
                  <controls:IconLabel Icon="external" Text="Versionen auf GitHub" />
                </Button>
              </controls:ActionBar>
              <mat:MatSettingRow Title="Automatisch nach Updates suchen" Description="Beim Start und alle 6 Stunden, im eigenen Kanal (Release oder Nightly).">
                <ToggleSwitch x:Name="CheckUpdatesSwitch" OnContent="" OffContent="" AutomationProperties.Name="Automatisch nach Updates suchen" />
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Updates automatisch installieren" BorderThickness="0"
                                 Description="Full-Auto-Update: neue Versionen werden ohne Rückfrage installiert, ThixSync startet danach neu im Hintergrund.">
                <ToggleSwitch x:Name="AutoInstallSwitch" OnContent="" OffContent="" AutomationProperties.Name="Updates automatisch installieren" />
              </mat:MatSettingRow>
            </StackPanel>
          </TabItem>

          <!-- ===== Advanced ===== -->
          <TabItem x:Name="AdvancedTabItem" Header="Erweitert">
            <StackPanel>
              <TextBlock Text="Eigene App-Registrierungen" Theme="{StaticResource MatText.SectionTitle}" FontSize="{DynamicResource Mat.FontSizeLg}" Margin="0,0,0,6" />
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,0,0,14"
                         Text="Für die Anmeldung bei Google Drive, OneDrive, SharePoint, Dropbox und Box nutzt ThixSync eigene App-Registrierungen. Leer: die eingebauten. Organisationen tragen hier ihre eigenen ein." />
              <Grid ColumnDefinitions="*,16,*" Width="760" HorizontalAlignment="Left">
                <StackPanel>
                  <mat:MatFormField Label="Google – Client-ID"><TextBox x:Name="GoogleIdBox" /></mat:MatFormField>
                  <mat:MatFormField Label="Microsoft – Client-ID" Hint="OneDrive und SharePoint"><TextBox x:Name="MicrosoftIdBox" /></mat:MatFormField>
                  <mat:MatFormField Label="Box – Client-ID"><TextBox x:Name="BoxIdBox" /></mat:MatFormField>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <mat:MatFormField Label="Google – Client-Secret"><TextBox x:Name="GoogleSecretBox" PasswordChar="●" /></mat:MatFormField>
                  <mat:MatFormField Label="Dropbox – App-Key"><TextBox x:Name="DropboxIdBox" /></mat:MatFormField>
                  <mat:MatFormField Label="Box – Client-Secret"><TextBox x:Name="BoxSecretBox" PasswordChar="●" /></mat:MatFormField>
                </StackPanel>
              </Grid>
              <controls:ActionBar Margin="0,0,0,20">
                <Button x:Name="SaveOAuthButton" Click="OnSaveOAuthClick">
                  <controls:IconLabel Icon="save" Text="App-Registrierungen speichern" />
                </Button>
              </controls:ActionBar>

              <mat:MatSettingRow Title="Datenordner" x:Name="DataFolderRow">
                <Button Click="OnOpenDataFolderClick">
                  <controls:IconLabel Icon="external" Text="Öffnen" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Problembericht" x:Name="LogFolderRow"
                                 Description="Stürzt ThixSync ab oder hängt es, steht ein Bericht im Log-Ordner – schick ihn mit, wenn du ein Problem meldest.">
                <Button Click="OnOpenLogFolderClick">
                  <controls:IconLabel Icon="file-text" Text="Log-Ordner öffnen" />
                </Button>
              </mat:MatSettingRow>
              <mat:MatSettingRow Title="Einstellungen zurücksetzen" BorderThickness="0"
                                 Description="Alle Einstellungen dieses Computers auf den Anfang – Aufträge, Verbindungen, Cloud und Remote bleiben.">
                <Button x:Name="ResetButton" Theme="{StaticResource MatButton.Danger}" Click="OnResetClick">
                  <controls:IconLabel Icon="restore" Text="Zurücksetzen" />
                </Button>
              </mat:MatSettingRow>
              <TextBlock Theme="{StaticResource MatText.Muted}" Margin="0,16,0,0"
                         Text="Administratoren können ThixSync per Richtlinie einschränken (LockConfiguration, DisableCloud, DisableUpdates, DisableDelete, DisableCloudStorage, DisableRemote) – unter Windows in HKLM\SOFTWARE\Policies\ThixSync, unter macOS per Konfigurationsprofil info.schmoldt.thixsync." />
            </StackPanel>
          </TabItem>
        </TabControl>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
