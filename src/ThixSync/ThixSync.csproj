<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The desktop application for Windows and macOS (Avalonia): the window with the jobs, tray / menu bar icon and - on
    Windows - its own setup (same program).
    Windows: published self-contained single-file for win-x64; that ThixSync.exe is its own setup (InstallService).
    macOS:   published self-contained for osx-arm64 / osx-x64 and packed into ThixSync.app (scripts/package-macos.sh).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(DesktopTargetFramework)</TargetFramework>
    <AssemblyName>ThixSync</AssemblyName>
    <RootNamespace>ThixSync</RootNamespace>
    <ApplicationIcon>Assets\thixsync.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ThixSync</AssemblyTitle>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <!-- Bindings in data templates resolve by reflection (the rows are plain view models). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <SupportedOSPlatformVersion Condition="'$(OS)' == 'Windows_NT'">10.0.17763.0</SupportedOSPlatformVersion>
    <!-- Start-up speed: the app starts at sign-in and must open its window at once. -->
    <TieredPGO>true</TieredPGO>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- No .pdb/.xml of the libraries next to the program either: the package is the program alone. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- Ready-to-run code: the window comes up without waiting for the JIT. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Windows: one file, which is also the setup (App.RunSetupIfRequested). Trimmed in "partial" mode: only libraries that
    declare themselves trimmable (the .NET runtime, the Windows SDK projection, Avalonia) lose what ThixSync
    never calls; ThixSync's own assemblies stay whole, so reflection bindings and the JSON of our own types keep working.
    That halves the download (about 75 MB to 38 MB). The self test of the published program (SelfTest.cs, run by CI)
    proves that the trimmed program works.
  -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Settings, sync and the update manifest use reflection-based JSON (our own types, kept whole). -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DefineConstants>$(DefineConstants);SINGLE_FILE</DefineConstants>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- macOS: the files go into ThixSync.app/Contents/MacOS (scripts/package-macos.sh). -->
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('osx-'))">
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ThixSync.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <!-- The snapshot command (Snapshot.cs) draws the windows without a screen. -->
    <PackageReference Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ThixSync.Core\ThixSync.Core.csproj" />
  </ItemGroup>

  <!--
    The command line travels inside ThixSync.exe (Windows): CI publishes thixsync-cli.exe first and passes it as
    -p:ThixSyncCliPath=<file>; the setup (InstallService) puts it next to ThixSync.exe and on the PATH. Builds without the property
    (local, tests, macOS) carry no command line.
  -->
  <ItemGroup Condition="'$(ThixSyncCliPath)' != ''">
    <EmbeddedResource Include="$(ThixSyncCliPath)" LogicalName="thixsync-cli.exe" Link="thixsync-cli.exe" />
  </ItemGroup>

  <Target Name="CheckThixSyncCliPath" BeforeTargets="BeforeBuild" Condition="'$(ThixSyncCliPath)' != '' And !Exists('$(ThixSyncCliPath)')">
    <Error Text="ThixSyncCliPath points to '$(ThixSyncCliPath)', which does not exist (publish src/ThixSync.Cli first)." />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\thixsync.ico" />
    <AvaloniaResource Include="Assets\tray-windows.ico" />
    <AvaloniaResource Include="Assets\tray-macos.png" />
    <AvaloniaResource Include="Assets\logo-256.png" />
    <AvaloniaResource Include="Assets\logo-64.png" />
  </ItemGroup>

</Project>
