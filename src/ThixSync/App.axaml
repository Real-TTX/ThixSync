<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ThixSync.App"
             Name="ThixSync"
             RequestedThemeVariant="Default">
  <!--
    The look is MatDesktop's (MatDesktop/, copied from MatDesign): App.Initialize installs its theme with ThixSync's accent
    (Fluent in the colours of the tokens, a brush per token in light and dark, the control themes of the flat look, the
    icons of the sprite, the lists and choices; every window takes the app's icon from it).
  -->
</Application>
