<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Matthias Schmoldt</Company>
    <Product>ThixSync</Product>
    <Authors>Matthias Schmoldt</Authors>
    <Copyright>© Matthias Schmoldt</Copyright>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The desktop projects (ThixSync.Core, ThixSync, ThixSync.Tests) use the Windows target framework when they are built on
    Windows: it brings the Windows APIs (shell, recycle bin, network connections). On macOS they are plain net10.0.
    The contract of MatCloud stays net10.0-compatible code.
  -->
  <PropertyGroup>
    <DesktopTargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</DesktopTargetFramework>
    <DesktopTargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</DesktopTargetFramework>
  </PropertyGroup>

  <!--
    Versioning (single source of truth: Major/Minor below). CI sets Channel / BuildNumber / BuildDate:
      release : <major>.<minor>.<build>-<date>   e.g. 0.1.42-20261114   (branch main)
      nightly : nightly-<build>-<date>          e.g. nightly-43-20261114 (branch dev)
      local   : local-<date>                    e.g. local-20261114      (every local build)
    The build number is the GitHub run number and increases with every build; the update check compares it.
  -->
  <PropertyGroup>
    <ThixSyncMajor>0</ThixSyncMajor>
    <ThixSyncMinor>1</ThixSyncMinor>

    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Channel Condition="'$(Channel)' == ''">local</Channel>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</BuildDate>

    <Version>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber)</Version>
    <AssemblyVersion>$(ThixSyncMajor).$(ThixSyncMinor).0.0</AssemblyVersion>
    <FileVersion>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Channel)' == 'release'">
    <InformationalVersion>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'nightly'">
    <InformationalVersion>nightly-$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'local'">
    <InformationalVersion>local-$(BuildDate)</InformationalVersion>
  </PropertyGroup>

  <!-- The running program needs channel and build number (update check, about page). -->
  <ItemGroup>
    <AssemblyMetadata Include="ThixSyncChannel" Value="$(Channel)" />
    <AssemblyMetadata Include="ThixSyncBuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="ThixSyncRepository" Value="Real-TTX/ThixSync" />
  </ItemGroup>

</Project>
