<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Matthias Schmoldt</Company>
    <Product>ThixSync</Product>
    <Authors>Matthias Schmoldt</Authors>
    <Copyright>© Matthias Schmoldt</Copyright>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    The desktop projects (ThixSync.Core, ThixSync, ThixSync.Cli and the tests) use the Windows target framework when they are built on
    Windows: it brings the Windows APIs (shell, recycle bin, network connections). On macOS they are plain net10.0.
    The contract of MatCloud stays net10.0-compatible code.
  -->
  <PropertyGroup>
    <DesktopTargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</DesktopTargetFramework>
    <DesktopTargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</DesktopTargetFramework>
  </PropertyGroup>

  <!--
    Versioning (single source of truth: Major/Minor below). CI sets Channel / BuildNumber / BuildDate:
      release : <major>.<minor>.<build>-<date>   e.g. 0.1.42-20261114   (branch main)
      nightly : nightly-<build>-<date>          e.g. nightly-43-20261114 (branch dev)
      local   : local-<date>                    e.g. local-20261114      (every local build)
    The build number is the GitHub run number and increases with every build; the update check compares it.
  -->
  <PropertyGroup>
    <ThixSyncMajor>0</ThixSyncMajor>
    <ThixSyncMinor>1</ThixSyncMinor>

    <BuildNumber Condition="'$(BuildNumber)' == ''">0</BuildNumber>
    <Channel Condition="'$(Channel)' == ''">local</Channel>
    <BuildDate Condition="'$(BuildDate)' == ''">$([System.DateTime]::UtcNow.ToString('yyyyMMdd'))</BuildDate>

    <Version>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber)</Version>
    <AssemblyVersion>$(ThixSyncMajor).$(ThixSyncMinor).0.0</AssemblyVersion>
    <FileVersion>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Channel)' == 'release'">
    <InformationalVersion>$(ThixSyncMajor).$(ThixSyncMinor).$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'nightly'">
    <InformationalVersion>nightly-$(BuildNumber)-$(BuildDate)</InformationalVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Channel)' == 'local'">
    <InformationalVersion>local-$(BuildDate)</InformationalVersion>
  </PropertyGroup>

  <!--
    The OAuth app registrations of the cloud storages (Google Drive, OneDrive/SharePoint, Dropbox, Box; docs/APP-REGISTRIERUNG.md).
    Users never see them: they just sign in. They come from the environment (CI: the repository secrets THIXSYNC_GOOGLE_CLIENT_ID,
    THIXSYNC_GOOGLE_CLIENT_SECRET, THIXSYNC_MICROSOFT_CLIENT_ID, THIXSYNC_DROPBOX_CLIENT_ID, THIXSYNC_BOX_CLIENT_ID and
    THIXSYNC_BOX_CLIENT_SECRET, mapped in desktop.yml) or from secrets.local.props next to this file (ignored by git, template:
    secrets.local.props.example). Empty: that type cannot sign in until the user enters an own registration (Einstellungen › Erweitert).
    Desktop apps cannot keep a secret: the Google and Box "client secrets" of a desktop app are not confidential.
  -->
  <Import Project="secrets.local.props" Condition="Exists('$(MSBuildThisFileDirectory)secrets.local.props')" />
  <PropertyGroup>
    <ThixSyncGoogleClientId Condition="'$(ThixSyncGoogleClientId)' == ''"></ThixSyncGoogleClientId>
    <ThixSyncGoogleClientSecret Condition="'$(ThixSyncGoogleClientSecret)' == ''"></ThixSyncGoogleClientSecret>
    <ThixSyncMicrosoftClientId Condition="'$(ThixSyncMicrosoftClientId)' == ''"></ThixSyncMicrosoftClientId>
    <ThixSyncDropboxClientId Condition="'$(ThixSyncDropboxClientId)' == ''"></ThixSyncDropboxClientId>
    <ThixSyncBoxClientId Condition="'$(ThixSyncBoxClientId)' == ''"></ThixSyncBoxClientId>
    <ThixSyncBoxClientSecret Condition="'$(ThixSyncBoxClientSecret)' == ''"></ThixSyncBoxClientSecret>
  </PropertyGroup>

  <!-- The running program needs channel, build number and the app registrations (update check, about page, sign-in). -->
  <ItemGroup>
    <AssemblyMetadata Include="ThixSyncChannel" Value="$(Channel)" />
    <AssemblyMetadata Include="ThixSyncBuildNumber" Value="$(BuildNumber)" />
    <AssemblyMetadata Include="ThixSyncRepository" Value="Real-TTX/ThixSync" />
    <AssemblyMetadata Include="ThixSyncGoogleClientId" Value="$(ThixSyncGoogleClientId)" />
    <AssemblyMetadata Include="ThixSyncGoogleClientSecret" Value="$(ThixSyncGoogleClientSecret)" />
    <AssemblyMetadata Include="ThixSyncMicrosoftClientId" Value="$(ThixSyncMicrosoftClientId)" />
    <AssemblyMetadata Include="ThixSyncDropboxClientId" Value="$(ThixSyncDropboxClientId)" />
    <AssemblyMetadata Include="ThixSyncBoxClientId" Value="$(ThixSyncBoxClientId)" />
    <AssemblyMetadata Include="ThixSyncBoxClientSecret" Value="$(ThixSyncBoxClientSecret)" />
  </ItemGroup>

</Project>
